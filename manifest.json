<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Start Project | youridea.in</title>
  <meta name="theme-color" content="#f5c34b" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    :root {
      --bg: #0a0d14; --panel: #111827; --panel-2: #171f2f; --primary: #f5c34b; --accent: #1ea2ff; --text: #edf3ff; --muted: #aab7cf; --line: rgba(255,255,255,0.10);
    }
    * { box-sizing:border-box; margin:0; padding:0; }
    body {
      font-family:'Inter', sans-serif; background: var(--bg); color: var(--text); overflow-x:hidden; -webkit-font-smoothing:antialiased;
    }
    a { color:inherit; text-decoration:none; }
    .mono { font-family:'JetBrains Mono', monospace; }
    .bg-orb {
      position:fixed; inset:0; pointer-events:none; z-index:0;
      background: radial-gradient(circle at 50% 0%, rgba(245,195,75,0.16), transparent 30%), radial-gradient(circle at 90% 20%, rgba(30,162,255,0.12), transparent 26%);
    }
    nav {
      position:relative; z-index:20; display:flex; align-items:center; justify-content:space-between; padding:18px 6%;
      background: rgba(10,13,20,0.8); border-bottom:1px solid var(--line); backdrop-filter: blur(12px);
    }
    .logo { display:flex; align-items:center; gap:10px; font-weight:800; letter-spacing:-0.04em; }
    .logo-mark { width:30px; height:30px; border-radius:12px; overflow:hidden; }
    .logo-text { text-transform: lowercase; }
    .wrap { position:relative; z-index:1; max-width:980px; margin:0 auto; padding:56px 6% 80px; }
    .layout { display:grid; grid-template-columns:0.96fr 1.04fr; gap:42px; align-items:center; }
    .eyebrow {
      display:inline-flex; align-items:center; gap:10px; padding:8px 16px; border-radius:999px; background: rgba(255,255,255,0.02); border:1px solid var(--line); color: var(--muted); font-family:'JetBrains Mono', monospace; font-size:0.72rem; letter-spacing:0.15em; text-transform:uppercase;
    }
    .eyebrow .dot { width:8px; height:8px; border-radius:50%; background: var(--primary); box-shadow: 0 0 10px rgba(245,195,75,0.8); }
    h1 { font-size:clamp(2.2rem, 5vw, 3.4rem); letter-spacing:-0.06em; line-height:0.95; margin:18px 0 16px; }
    h1 .accent { background: linear-gradient(90deg, var(--primary), #ffd979 45%, var(--accent)); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .lead { color: var(--muted); line-height:1.8; }
    .steps { margin-top:30px; display:grid; gap:18px; }
    .step { display:flex; gap:12px; align-items:flex-start; }
    .num {
      width:30px; height:30px; border-radius:10px; display:grid; place-items:center; background: rgba(245,195,75,0.12); color: var(--primary); border:1px solid rgba(245,195,75,0.2); font-weight:800; font-family:'JetBrains Mono', monospace;
    }
    .step p { font-weight:700; }
    .step span { display:block; color:var(--muted); margin-top:4px; }
    .box {
      background: linear-gradient(180deg, rgba(17,24,39,0.86), rgba(21,31,50,0.9)); border:1px solid var(--line); border-radius:26px; padding:32px 26px;
    }
    .box h2 { margin-bottom:6px; font-size:1.5rem; }
    .sub { color: var(--muted); margin-bottom:22px; }
    .field { margin-bottom:18px; }
    label {
      display:block; margin-bottom:8px; color: var(--muted); font-size:0.76rem; letter-spacing:0.12em; text-transform:uppercase; font-family:'JetBrains Mono', monospace;
    }
    input, textarea {
      width:100%; border:1px solid var(--line); background: rgba(10,13,20,0.6); color: var(--text); border-radius:12px; padding:14px 16px; font:inherit; resize:vertical; outline:none; transition:0.25s ease;
    }
    input:focus, textarea:focus { border-color: rgba(245,195,75,0.55); box-shadow: 0 0 0 4px rgba(245,195,75,0.1); }
    button {
      width:100%; padding:16px 18px; border:none; border-radius:12px; font:inherit; font-weight:800; background: var(--primary); color:#171410; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:10px; transition:0.25s ease;
    }
    button:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(245,195,75,0.2); }
    .thank-you { display:none; text-align:center; padding:24px 0 10px; }
    .thank-you .icon {
      width:64px; height:64px; margin:0 auto 14px; border-radius:50%; display:grid; place-items:center; background: rgba(245,195,75,0.12); border:1px solid rgba(245,195,75,0.3); color:var(--primary); font-size:1.5rem;
    }
    .thank-you h3 { font-size:1.7rem; margin-bottom:8px; }
    .thank-you p { color:var(--muted); max-width:330px; margin:0 auto; line-height:1.7; }
    @media (max-width:820px) { .layout { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <div class="bg-orb"></div>
  <nav>
    <a class="logo" href="home.html">
      <img class="logo-mark" src="images/youridea-logo.svg" alt="youridea.in" />
      <span class="logo-text">youridea.in</span>
    </a>
    <a href="home.html" style="font-weight:700;">Back Home</a>
  </nav>

  <div class="wrap">
    <div class="layout">
      <div>
        <div class="eyebrow"><span class="dot"></span> Start a project</div>
        <h1>Tell us what you're <span class="accent">building</span></h1>
        <p class="lead">Share your idea, goals, and timeline, and we'll guide you through the best website or branding plan for your business.</p>

        <div class="steps">
          <div class="step"><span class="num">1</span><div><p>Share your brief</p><span>Name, email, and what you need</span></div></div>
          <div class="step"><span class="num">2</span><div><p>We review and reply</p><span>Usually within a few hours</span></div></div>
          <div class="step"><span class="num">3</span><div><p>Your site goes live</p><span>Fast, polished, and launch-ready</span></div></div>
        </div>
      </div>

      <div class="box">
        <div id="form-box">
          <h2>Project Brief</h2>
          <p class="sub">All fields required — the more detail, the better.</p>
          <form id="project-form" action="https://formspree.io/f/xlgkqvdv" method="POST">
            <div class="field">
              <label for="name">Full name</label>
              <input id="name" name="name" type="text" placeholder="Your name" required />
            </div>
            <div class="field">
              <label for="email">Email address</label>
              <input id="email" name="email" type="email" placeholder="you@example.com" required />
            </div>
            <div class="field">
              <label for="message">Project details</label>
              <textarea id="message" name="message" rows="5" placeholder="Describe your business, what you need, and your goals..." required></textarea>
            </div>
            <button type="submit">
              <span>Submit Project</span>
              <i class="fas fa-arrow-right"></i>
            </button>
          </form>
        </div>

        <div class="thank-you" id="thank-you">
          <div class="icon"><i class="fas fa-check"></i></div>
          <h3>Thank you!</h3>
          <p>Your project brief has been submitted. We'll get back to you shortly.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('project-form');
    const formBox = document.getElementById('form-box');
    const thankYou = document.getElementById('thank-you');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const btn = form.querySelector('button');
      btn.disabled = true;
      btn.innerHTML = '<span>Sending...</span>';
      const data = new FormData(form);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        });
        if (response.ok) {
          formBox.style.display = 'none';
          thankYou.style.display = 'block';
        } else {
          alert('Something went wrong. Please try again.');
          btn.disabled = false;
          btn.innerHTML = '<span>Submit Project</span><i class="fas fa-arrow-right"></i>';
        }
      } catch (err) {
        alert('Network error. Please try again.');
        btn.disabled = false;
        btn.innerHTML = '<span>Submit Project</span><i class="fas fa-arrow-right"></i>';
      }
    });
  </script>
</body>
</html>







